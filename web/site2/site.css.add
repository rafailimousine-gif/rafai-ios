/* sections et cartes blanches de Google Sites */
.yaqOZd:before{background-color:#0b0b0c!important}
.yaqOZd.qeLZfd:before{background-color:#111012!important}
.yaqOZd:not([style*="background-image"]),.IFuOkc:not([style*="background-image"]){background-color:transparent}
