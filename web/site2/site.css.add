/* blocs ajoutés par le site : trajets populaires, équipe, 404 */
html body .rlrt{color:#c8c2b6}html body .rlrt .k{color:#E0BA6C}html body .rlrt h2,html body .rlrt h3,html body .rlrt dd{color:#f3eee4}html body .rlrt .p,html body .rlrt .s,html body .rlrt dt{color:#b9b3a7}
html body .rlrt .c{background:#141316;border-color:rgba(224,186,108,.24)}html body .rlrt dt,html body .rlrt dd{border-top-color:rgba(224,186,108,.14)}
html body .rlrt .b{background:linear-gradient(135deg,#f0d394 0%,#d9b36a 45%,#b8873f 100%);color:#16110a}html body .rlrt .b:hover{background:#E0BA6C}
html body .rlteam{color:#c8c2b6}html body .rlteam h1{color:#f3eee4}html body .rlteam .k,html body .rlteam .v{color:#E0BA6C}
html body .rlteam .cards div{background:#141316;border-color:rgba(224,186,108,.24)}html body .rlteam .cards h2{color:#E0BA6C}html body .rlteam .cards p{color:#c8c2b6}
html body .rlteam .cta a.w{background:linear-gradient(135deg,#f0d394 0%,#d9b36a 45%,#b8873f 100%);color:#16110a}html body .rlteam .cta a.c{border-color:#E0BA6C;color:#E0BA6C}
/* barre du haut : seulement les logos des stores, plus fine */
#rlbar{padding:5px 12px}#rlbar .st img{height:26px}
@media (max-width:899px){#rlbar .st img{height:24px}}
/* agent IA en tout petit (10 nov. 2026, demande de Yassine) : petit rond, bulle courte ; sur téléphone seulement le rond */
#rlyfab{width:44px;height:44px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));box-shadow:0 0 0 1.5px #E0BA6C,0 8px 18px -6px rgba(17,17,19,.6)}
#rlyfab:before{inset:-3px;border-width:1.5px}
#rlyfab:after{right:1px;bottom:2px;width:9px;height:9px;border-width:1.5px}
#rlyfab .rlwave{left:-7px;top:-9px;font-size:15px}
#rlytz{right:64px;bottom:calc(19px + env(safe-area-inset-bottom));max-width:none;padding:5px 10px;border-radius:12px 12px 3px 12px;font-size:12px;line-height:1.3;white-space:nowrap}
#rlytz b{display:inline;font-size:12px}
#rlytz span{display:none}
@media (max-width:599px){#rlyfab{width:40px;height:40px;right:10px}#rlytz{display:none}}
