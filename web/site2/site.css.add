#rlbar{display:flex;align-items:center;justify-content:center;gap:16px;background:#0c0c0e;color:#fff;padding:8px 16px;font:500 14px/1.35 Manrope,system-ui,sans-serif}
#rlbar p{margin:0}
#rlbar a{flex:none;color:#fff;border:1px solid #fff;border-radius:4px;padding:6px 20px;font-size:13px;text-decoration:none}
#rlbar .st{display:flex;gap:8px;flex:none;align-items:center}
#rlbar .st a{border:0;padding:0;border-radius:0;display:block;line-height:0}
#rlbar .st img{height:30px;width:auto;display:block}
.rlgp{display:block;margin-top:10px;line-height:0}
.rlgp img{height:58px;width:auto;display:block}
#rlnav{position:sticky;top:0;z-index:100;display:flex;align-items:center;gap:12px;height:64px;padding:0 24px;background:#fff;box-shadow:0 1px 0 rgba(0,0,0,.06);font:500 15px/1 Manrope,system-ui,sans-serif;color:#111}
#rlnav .brand{display:flex;align-items:center;gap:12px;color:#111;text-decoration:none;font-size:20px}
#rlnav .brand img{border-radius:6px}
#rlnav nav{margin-left:auto}
#rlnav ul{list-style:none;margin:0;padding:0}
#rlnav nav>ul{display:flex;align-items:center;gap:22px}
#rlnav li{position:relative}
#rlnav a{color:#111;text-decoration:none}
@media (min-width:900px){#rlnav nav>ul>li>a{display:inline-block;padding:5px 0}}
#rlnav nav a.on{font-weight:800}
#rlnav li.dd>button{width:24px;height:24px;margin-left:0;padding:0;border:0;background:none;cursor:pointer;vertical-align:middle;position:relative}
#rlnav li.dd>button:after{content:"";position:absolute;left:8px;top:6px;width:6px;height:6px;border:solid #111;border-width:0 2px 2px 0;transform:rotate(45deg)}
#rlnav li ul{display:none;position:absolute;top:100%;left:0;min-width:210px;margin-top:10px;padding:8px 0;background:#fff;border-radius:6px;box-shadow:0 8px 24px rgba(0,0,0,.14)}
#rlnav li ul a{display:block;padding:10px 16px;white-space:nowrap}
#rlnav li ul li.dd>a{padding-right:30px}
#rlnav li ul li.dd>button{position:absolute;right:8px;top:9px}
#rlnav li ul ul{position:static;margin:0 0 0 12px;box-shadow:none;padding:0}
#rlnav li.open>ul{display:block}
@media (hover:hover) and (min-width:900px){#rlnav nav>ul>li:hover>ul{display:block}#rlnav li ul:before{content:"";position:absolute;left:0;right:0;top:-12px;height:12px}}
#rlmenu{display:none;width:40px;height:40px;padding:10px;border:0;background:none;cursor:pointer}
#rlmenu i{display:block;height:2px;margin:4px 0;background:#111}
.rlif{position:absolute;inset:0;width:100%;height:100%;border:0;display:block}
@media (max-width:899px){
#rlbar{gap:10px;padding:8px 12px;font-size:12.5px}
#rlbar a{padding:6px 12px}
#rlbar .st a{padding:0}
#rlbar .st{gap:6px}
#rlbar .st img{height:26px}
#rlnav{height:56px;padding:0 8px}
#rlnav .brand{font-size:18px}
#rlmenu{display:block}
#rlnav nav{position:fixed;left:0;right:0;top:56px;bottom:0;margin:0;background:#fff;overflow:auto;padding:12px 20px 32px;transform:translateX(-100%);transition:transform .2s;z-index:-1}
#rlnav.open nav{transform:none}
#rlnav.open{z-index:200}
#rlnav.open #rlmenu{position:relative;z-index:2}
#rlnav nav>ul{display:block}
#rlnav nav li{padding:0}
#rlnav nav a{display:inline-block;padding:13px 0;font-size:17px}
#rlnav li.dd>button{position:absolute;right:0;top:6px;width:40px;height:40px}
#rlnav li.dd>button:after{left:16px;top:13px}
#rlnav li ul{position:static;box-shadow:none;margin:0 0 0 14px;padding:0;min-width:0}
#rlnav li ul a{padding:11px 0;white-space:normal}
#rlnav li ul li.dd>button{top:2px}
}
html,body{height:auto!important}
.UtePc.RCETm.SwuGbc{margin-top:0!important}
.zfr3Q.JYVBee[dir=rtl],.zfr3Q.OmQG5e[dir=rtl]{text-align:right!important}
.rlsolo{text-align:center}
#rlyfab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:150;width:62px;height:62px;padding:0;border:0;border-radius:50%;cursor:pointer;background:#fff;box-shadow:0 0 0 2px #E0BA6C,0 14px 28px -8px rgba(17,17,19,.65)}
#rlyfab img{display:block;width:100%;height:100%;border-radius:50%;object-fit:cover}
#rlyfab:before{content:"";position:absolute;inset:-5px;border-radius:50%;border:2px solid rgba(201,160,99,.75);animation:rlring 2.4s ease-out infinite}
#rlyfab:after{content:"";position:absolute;right:3px;bottom:4px;width:13px;height:13px;border-radius:50%;background:#3BC17A;border:2px solid #fff}
@keyframes rlring{0%{transform:scale(.9);opacity:.9}100%{transform:scale(1.35);opacity:0}}
#rlytz{position:fixed;right:90px;bottom:calc(21px + env(safe-area-inset-bottom));z-index:150;max-width:230px;padding:10px 13px;border:1px solid #E5E3DE;border-radius:16px 16px 4px 16px;background:#fff;color:#111113;font:500 13.5px/1.4 Manrope,system-ui,sans-serif;text-align:start;cursor:pointer;box-shadow:0 14px 30px -16px rgba(17,17,19,.45)}
#rlytz b{display:block;font-size:14px}
#rlyframe{display:none;position:fixed;right:16px;bottom:16px;z-index:300;width:400px;height:min(680px,calc(100vh - 32px));border:0;border-radius:18px;background:transparent;box-shadow:0 24px 50px -20px rgba(17,17,19,.5)}
.rly #rlyframe{display:block}
.rly #rlyfab,.rly #rlytz{display:none}
@media (max-width:599px){#rlyframe{left:0;top:0;right:0;bottom:auto;width:100%;height:100%;border-radius:0;background:#fff}html.rly,html.rly body{overflow:hidden}}
@media (prefers-reduced-motion:reduce){#rlyfab:before{animation:none}}
#rlyfab .rlwave{position:absolute;left:-10px;top:-12px;font-size:25px;line-height:1;transform-origin:70% 85%;animation:rlwave 2.2s ease-in-out infinite;filter:drop-shadow(0 2px 3px rgba(0,0,0,.3))}
@keyframes rlwave{0%,62%,100%{transform:rotate(0)}8%{transform:rotate(18deg)}16%{transform:rotate(-10deg)}24%{transform:rotate(18deg)}32%{transform:rotate(-6deg)}40%{transform:rotate(12deg)}48%{transform:rotate(0)}}
@media (prefers-reduced-motion:reduce){#rlyfab .rlwave{animation:none}}
@media (min-width:1100px){
.rlbook-bg{white-space:nowrap}.rlbook-bg>*{white-space:normal}
.rlbook-bg>.rlbook{width:max(54%,min(900px,calc(100vw - 650px)))!important;margin-right:-300px}
.rlbook-bg>.rlbook .WIdY2d{height:840px!important}
.rlbook-duo>.rlbook{width:56%!important}
.rlbook-duo>:not(.rlbook){width:44%!important}
}
/* écran appli sur téléphone : petite fenêtre noire et dorée en bas, le site reste visible derrière (demande de Yassine, 10 nov.) */
#rlch{position:fixed;left:12px;right:12px;bottom:calc(12px + env(safe-area-inset-bottom));z-index:2147483600;box-sizing:border-box;max-width:400px;margin:0 auto;max-height:calc(100vh - 100px);overflow:auto;border-radius:22px;background:#0B0B0C;border:1px solid rgba(224,186,108,.6);box-shadow:0 18px 50px rgba(0,0,0,.55);color:#fff;font-family:Manrope,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;text-align:center;animation:rlchUp .55s cubic-bezier(.2,.8,.2,1) both}
#rlch .ph{position:relative;height:clamp(130px,40vw,165px);background:#0B0B0C url(/img/rlch-3.webp) center 42%/cover no-repeat}
#rlch .ph:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,11,12,0) 52%,#0B0B0C 100%)}
#rlch button.x{position:absolute;top:10px;right:10px;z-index:2;width:34px;height:34px;padding:0;border-radius:50%;border:1px solid rgba(224,186,108,.7);background:rgba(11,11,12,.62);color:#E7C27A;font:400 24px/30px Manrope,Arial,sans-serif;cursor:pointer;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px)}
#rlch[dir=rtl] button.x{right:auto;left:10px}
#rlch .bt{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:-26px;padding:0 20px 14px}
#rlch .tp{position:relative;display:flex;align-items:center;gap:10px}
#rlch .lg{position:relative;display:block;width:44px;height:44px;border-radius:11px;overflow:hidden;box-shadow:0 0 0 1px rgba(201,164,92,.6),0 6px 18px rgba(0,0,0,.5);animation:rlLgIn .9s cubic-bezier(.2,.8,.2,1) .3s both}
#rlch .lg img{display:block;width:44px;height:44px}
#rlch .lg:after{content:"";position:absolute;top:-10%;bottom:-10%;left:0;width:55%;background:linear-gradient(100deg,rgba(255,236,190,0),rgba(255,236,190,.6),rgba(255,236,190,0));transform:translateX(-200%) skewX(-20deg);animation:rlLgShine 3.2s ease-in-out 1.2s infinite}
#rlch .tp:before{content:"";position:absolute;top:0;left:0;width:44px;height:44px;border-radius:11px;box-shadow:0 0 0 1px rgba(231,194,122,.95),0 0 22px rgba(231,194,122,.5);opacity:0;animation:rlLgGlow 3.2s ease-in-out 1.5s infinite;pointer-events:none}
#rlch[dir=rtl] .tp:before{left:auto;right:0}
#rlch .tp b{font-size:11px;letter-spacing:.3em;font-weight:800;color:#E7C27A;animation:rlLgTx 1s ease .55s both}
@keyframes rlLgIn{0%{opacity:0;transform:scale(.5) rotate(-10deg)}60%{opacity:1;transform:scale(1.08) rotate(1deg)}100%{opacity:1;transform:none}}
@keyframes rlLgShine{0%{transform:translateX(-200%) skewX(-20deg)}40%,100%{transform:translateX(260%) skewX(-20deg)}}
@keyframes rlLgGlow{0%,100%{opacity:0}50%{opacity:1}}
@keyframes rlLgTx{0%{opacity:0;transform:translateY(8px)}100%{opacity:1;transform:none}}
@keyframes rlchUp{0%{opacity:0;transform:translateY(46px)}100%{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){#rlch,#rlch .lg,#rlch .lg:after,#rlch .tp:before,#rlch .tp b{animation:none}}
#rlch h2{margin:4px 0 0;font-size:21px;line-height:1.2;font-weight:800;color:#fff}
#rlch p{margin:0 0 4px;font-size:14px;line-height:1.45;color:rgba(255,255,255,.78)}
#rlch a.go{display:block;width:100%;box-sizing:border-box;padding:14px 16px;border-radius:14px;background:linear-gradient(135deg,#f0d394 0%,#d9b36a 45%,#b8873f 100%);color:#16110A;font-size:16px;font-weight:800;text-decoration:none;box-shadow:0 8px 24px rgba(199,154,74,.3)}
#rlch .sto{font-size:12px;color:rgba(255,255,255,.55)}
#rlch button.st{padding:6px;border:0;background:none;color:rgba(224,186,108,.9);font:inherit;font-size:13px;text-decoration:underline;cursor:pointer}
html.rlchon #rlyfab,html.rlchon #rlytz{display:none}
/* fenêtre -10 % première course (11 nov. 2026) */
#rlch.rlpm .ph{height:clamp(104px,28vw,136px)}
#rlch .bd{display:flex;flex-direction:column;align-items:center;gap:8px;width:100%}
#rlch h2 .pc{color:#E7C27A;white-space:nowrap}
#rlch .pf{display:flex;flex-direction:column;gap:8px;width:100%;margin:2px 0 0}
#rlch .pf .two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#rlch .pf input:not([type=checkbox]){display:block;width:100%;min-width:0;box-sizing:border-box;padding:12px 13px;border-radius:12px;border:1px solid rgba(224,186,108,.35);background:#16161A;color:#fff;font:500 16px/1.2 Manrope,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;outline:none;-webkit-appearance:none;appearance:none}
#rlch .pf input:focus{border-color:#E0BA6C;box-shadow:0 0 0 3px rgba(224,186,108,.18)}
#rlch .pf input.bad{border-color:#E5484D}
#rlch .pf input::placeholder{color:rgba(255,255,255,.45)}
#rlch .pf .hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0;pointer-events:none}
#rlch .ck{display:flex;align-items:flex-start;gap:8px;text-align:left;font-size:12px;line-height:1.35;color:rgba(255,255,255,.7);cursor:pointer}
#rlch .ck input{flex:none;width:16px;height:16px;margin:1px 0 0;accent-color:#D9B36A}
#rlch .er{font-size:13px;line-height:1.35;color:#FF8A8A}
#rlch .er:empty{display:none}
#rlch .go{display:block;width:100%;box-sizing:border-box;padding:14px 16px;border:0;border-radius:14px;background:linear-gradient(135deg,#f0d394 0%,#d9b36a 45%,#b8873f 100%);color:#16110A;font:800 16px/1.2 Manrope,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;text-decoration:none;text-align:center;cursor:pointer;box-shadow:0 8px 24px rgba(199,154,74,.3)}
#rlch .go[disabled]{opacity:.7;cursor:default}
#rlch .lgl{font-size:11px;line-height:1.4;color:rgba(255,255,255,.5)}
#rlch .lgl a{color:rgba(224,186,108,.9)}
#rlch a.app{font-size:13px;color:#E7C27A}
#rlch .cd{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;box-sizing:border-box;margin:4px 0;padding:14px;border:2px dashed rgba(224,186,108,.8);border-radius:14px}
#rlch .cd b{font-size:25px;letter-spacing:.1em;color:#fff}
#rlch .cd .cp{padding:7px 12px;border-radius:10px;border:1px solid rgba(224,186,108,.7);background:none;color:#E7C27A;font:700 13px Manrope,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;cursor:pointer}

/* ===== fond noir doré sur tout le site (10 nov. 2026, demande de Yassine) ===== */
html,body{background:#0b0b0c!important;color-scheme:dark}
body{color:#c8c2b6}
#rlbar{background:#070708;border-bottom:1px solid rgba(224,186,108,.2)}
#rlbar a{color:#E0BA6C;border-color:rgba(224,186,108,.7)}
#rlnav{background:rgba(11,11,12,.96);color:#f3eee4;box-shadow:0 1px 0 rgba(224,186,108,.3)}
#rlnav .brand,#rlnav a{color:#f3eee4}
#rlnav nav a.on,#rlnav a:hover{color:#E0BA6C}
#rlnav li.dd>button:after{border-color:#E0BA6C}
#rlnav li ul{background:#141316;box-shadow:0 10px 30px rgba(0,0,0,.6),0 0 0 1px rgba(224,186,108,.22)}
#rlmenu i{background:#f3eee4}
@media (max-width:899px){#rlnav nav{background:#0b0b0c}#rlnav li ul{background:none;box-shadow:none}}
